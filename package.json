{
  "name": "okaychat-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @okaychat/web",
    "dev:web": "npm run dev --workspace @okaychat/web",
    "dev:api": "npm run start:dev --workspace @okaychat/api",
    "db:generate": "npm run db:generate --workspace @okaychat/db",
    "db:migrate": "npm run db:migrate --workspace @okaychat/db",
    "db:deploy": "npm run db:deploy --workspace @okaychat/db"
  }
}
