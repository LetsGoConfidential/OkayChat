{
  "name": "okaychat-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @okaychat/web dev",
    "dev:web": "pnpm --filter @okaychat/web dev",
    "dev:api": "pnpm --filter @okaychat/api start:dev",
    "build": "pnpm --filter @okaychat/api build && pnpm --filter @okaychat/web build",
    "typecheck": "pnpm --filter @okaychat/api exec tsc --noEmit && pnpm --filter @okaychat/web exec tsc --noEmit",
    "db:generate": "pnpm --filter @okaychat/db db:generate",
    "db:migrate": "pnpm --filter @okaychat/db db:migrate",
    "db:deploy": "pnpm --filter @okaychat/db db:deploy"
  }
}
